{
  "name": "kicktipp-bot",
  "description": "A simple but effective kicktipp bot using different strategies for tipping.",
  "author": "Andreas Schmid <service@aaschmid.de>",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaschmid/kicktipp-bot"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "run-s test:format test:lint license:check test:unit test:build",
    "license:check": "node scripts/check-licenses.mjs",
    "test:build": "run-s build",
    "test:format": "biome format .",
    "test:format:fix": "biome format --write .",
    "test:lint": "biome check --formatter-enabled=false .",
    "test:lint:fix": "biome check --formatter-enabled=false --write .",
    "test:unit": "vitest run --typecheck",
    "test:ui": "vitest --typecheck --ui",
    "test:watch": "vitest --typecheck"
  },
  "dependencies": {
    "@playwright/browser-chromium": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "playwright": "^1.65.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@vitest/coverage-istanbul": "^5.0.2",
    "npm-run-all": "^4.1.5",
    "vitest": "^5.0.2"
  }
}
